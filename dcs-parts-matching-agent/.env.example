# DCS Parts Matching Agent Configuration
# Copy this file to .env and fill in your values

# API Keys (at least one is required for vision/text processing)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# AI Model Settings
USE_VISION_MODEL=gpt-4-vision-preview
# Alternatives: claude-3-opus-20240229, claude-3-sonnet-20240229
USE_EMBEDDING_MODEL=text-embedding-3-large
TEMPERATURE=0.1
MAX_TOKENS=4096

# API Server Settings
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
DEBUG=false

# File Upload Settings
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=data/uploads

# Vector Database Settings
VECTOR_DB_TYPE=chromadb
VECTOR_DB_PATH=data/vector_db
COLLECTION_NAME_CATALOG=dcs_parts_catalog
COLLECTION_NAME_DRAWINGS=technical_drawings

# Catalog Settings
CATALOG_PATH=data/catalog
DRAWINGS_PATH=data/drawings
AUTO_INDEX_ON_STARTUP=true
REINDEX_INTERVAL_HOURS=24

# OCR Settings
OCR_ENGINE=tesseract
# Options: tesseract, aws_textract, azure_form_recognizer

# For AWS Textract (optional)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key

# For Azure Form Recognizer (optional)
# AZURE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
# AZURE_API_KEY=your_azure_key

# Logging Settings
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_ROTATION=500 MB
LOG_RETENTION=30 days
ENABLE_REQUEST_LOGGING=true

# Performance Settings
CACHE_TTL_SECONDS=3600
MAX_CONCURRENT_REQUESTS=10
REQUEST_TIMEOUT_SECONDS=300
ENABLE_CACHING=true

# Matching Engine Settings
DIMENSIONAL_TOLERANCE_PERCENT=5.0
CRITICAL_SPECS_WEIGHT=2.0
