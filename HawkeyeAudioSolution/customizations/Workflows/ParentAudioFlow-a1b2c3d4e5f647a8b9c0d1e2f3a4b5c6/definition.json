{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "$connections": {
      "defaultValue": {},
      "type": "Object"
    },
    "$authentication": {
      "defaultValue": {},
      "type": "SecureObject"
    },
    "hawkeye_AudioFolderPath (hawkeye_AudioFolderPath)": {
      "defaultValue": "/Hawkeye/Audio Recordings/",
      "type": "String",
      "metadata": {
        "schemaName": "hawkeye_AudioFolderPath",
        "description": "OneDrive folder path for audio recordings"
      }
    },
    "hawkeye_MeetingIdentifierPrefix (hawkeye_MeetingIdentifierPrefix)": {
      "defaultValue": "MTG001",
      "type": "String",
      "metadata": {
        "schemaName": "hawkeye_MeetingIdentifierPrefix",
        "description": "Prefix for meeting file naming convention"
      }
    }
  },
  "triggers": {
    "When_a_file_is_created_in_a_folder": {
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "connectionName": "shared_onedriveforbusiness",
          "operationId": "OnNewFile",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_onedriveforbusiness"
        },
        "parameters": {
          "dataset": "root",
          "folderId": "@parameters('hawkeye_AudioFolderPath (hawkeye_AudioFolderPath)')",
          "inferContentType": true,
          "queryParameters": {
            "inferContentType": true
          }
        },
        "authentication": "@parameters('$authentication')"
      },
      "metadata": {
        "operationMetadataId": "trigger-001"
      }
    }
  },
  "actions": {
    "Initialize_Original_File_Name": {
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "OriginalFileName",
            "type": "string",
            "value": "@triggerOutputs()?['body/Name']"
          }
        ]
      },
      "runAfter": {},
      "metadata": {
        "operationMetadataId": "action-001"
      }
    },
    "Initialize_File_Extension": {
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "FileExtension",
            "type": "string",
            "value": "@last(split(variables('OriginalFileName'), '.'))"
          }
        ]
      },
      "runAfter": {
        "Initialize_Original_File_Name": [
          "Succeeded"
        ]
      },
      "metadata": {
        "operationMetadataId": "action-002"
      }
    },
    "Get_Current_Date": {
      "type": "Compose",
      "inputs": "@utcNow('yyyy_MM_dd')",
      "runAfter": {
        "Initialize_File_Extension": [
          "Succeeded"
        ]
      },
      "metadata": {
        "operationMetadataId": "action-003"
      }
    },
    "Initialize_Description": {
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "FileDescription",
            "type": "string",
            "value": "@replace(replace(variables('OriginalFileName'), concat('.', variables('FileExtension')), ''), ' ', '_')"
          }
        ]
      },
      "runAfter": {
        "Get_Current_Date": [
          "Succeeded"
        ]
      },
      "metadata": {
        "operationMetadataId": "action-004"
      }
    },
    "Compose_New_File_Name": {
      "type": "Compose",
      "inputs": "@concat(parameters('hawkeye_MeetingIdentifierPrefix (hawkeye_MeetingIdentifierPrefix)'), '_', outputs('Get_Current_Date'), '_', variables('FileDescription'), '.', variables('FileExtension'))",
      "runAfter": {
        "Initialize_Description": [
          "Succeeded"
        ]
      },
      "metadata": {
        "operationMetadataId": "action-005"
      }
    },
    "Get_File_Content": {
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "connectionName": "shared_onedriveforbusiness",
          "operationId": "GetFileContent",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_onedriveforbusiness"
        },
        "parameters": {
          "id": "@triggerOutputs()?['body/Id']",
          "inferContentType": true
        },
        "authentication": "@parameters('$authentication')"
      },
      "runAfter": {
        "Compose_New_File_Name": [
          "Succeeded"
        ]
      },
      "metadata": {
        "operationMetadataId": "action-006"
      }
    },
    "Create_File_With_New_Name": {
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "connectionName": "shared_onedriveforbusiness",
          "operationId": "CreateFile",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_onedriveforbusiness"
        },
        "parameters": {
          "dataset": "root",
          "folderPath": "@parameters('hawkeye_AudioFolderPath (hawkeye_AudioFolderPath)')",
          "name": "@outputs('Compose_New_File_Name')",
          "body": "@body('Get_File_Content')"
        },
        "authentication": "@parameters('$authentication')"
      },
      "runAfter": {
        "Get_File_Content": [
          "Succeeded"
        ]
      },
      "metadata": {
        "operationMetadataId": "action-007"
      }
    },
    "Delete_Original_File": {
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "connectionName": "shared_onedriveforbusiness",
          "operationId": "DeleteFile",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_onedriveforbusiness"
        },
        "parameters": {
          "id": "@triggerOutputs()?['body/Id']"
        },
        "authentication": "@parameters('$authentication')"
      },
      "runAfter": {
        "Create_File_With_New_Name": [
          "Succeeded"
        ]
      },
      "metadata": {
        "operationMetadataId": "action-008"
      }
    },
    "Call_Child_Flow_OneNote": {
      "type": "Workflow",
      "inputs": {
        "host": {
          "workflowReferenceName": "b2c3d4e5-f6a7-48b9-c0d1-e2f3a4b5c6d7"
        },
        "body": {
          "FileId": "@outputs('Create_File_With_New_Name')?['body/Id']",
          "FileName": "@outputs('Compose_New_File_Name')",
          "FileContent": "@body('Get_File_Content')"
        }
      },
      "runAfter": {
        "Delete_Original_File": [
          "Succeeded"
        ]
      },
      "metadata": {
        "operationMetadataId": "action-009"
      }
    },
    "Call_Child_Flow_AI_Summary": {
      "type": "Workflow",
      "inputs": {
        "host": {
          "workflowReferenceName": "c3d4e5f6-a7b8-49c0-d1e2-f3a4b5c6d7e8"
        },
        "body": {
          "FileName": "@outputs('Compose_New_File_Name')",
          "TranscriptContent": "@outputs('Call_Child_Flow_OneNote')?['body/TranscriptContent']"
        }
      },
      "runAfter": {
        "Call_Child_Flow_OneNote": [
          "Succeeded"
        ]
      },
      "metadata": {
        "operationMetadataId": "action-010"
      }
    }
  },
  "outputs": {}
}
