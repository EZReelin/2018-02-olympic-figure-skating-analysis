{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "$connections": {
      "defaultValue": {},
      "type": "Object"
    },
    "$authentication": {
      "defaultValue": {},
      "type": "SecureObject"
    },
    "hawkeye_SummaryFolderPath (hawkeye_SummaryFolderPath)": {
      "defaultValue": "/Hawkeye/Summaries/",
      "type": "String",
      "metadata": {
        "schemaName": "hawkeye_SummaryFolderPath",
        "description": "OneDrive folder path for summary PDF files"
      }
    }
  },
  "triggers": {
    "manual": {
      "type": "Request",
      "kind": "Button",
      "inputs": {
        "schema": {
          "type": "object",
          "properties": {
            "FileName": {
              "type": "string",
              "description": "Name of the audio file"
            },
            "TranscriptContent": {
              "type": "string",
              "description": "Full transcript text to summarize"
            }
          },
          "required": [
            "FileName",
            "TranscriptContent"
          ]
        }
      },
      "metadata": {
        "operationMetadataId": "trigger-child2-001"
      }
    }
  },
  "actions": {
    "Initialize_File_Name_Without_Extension": {
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "FileNameWithoutExt",
            "type": "string",
            "value": "@replace(triggerBody()?['FileName'], concat('.', last(split(triggerBody()?['FileName'], '.'))), '')"
          }
        ]
      },
      "runAfter": {},
      "metadata": {
        "operationMetadataId": "action-child2-001"
      }
    },
    "Create_Summary_Prompt": {
      "type": "Compose",
      "inputs": "@concat('Analyze the following transcript and provide:\n1. A concise summary (2-3 paragraphs)\n2. Key topics discussed\n3. Important insights and takeaways\n4. Action items (if any)\n5. Patterns and themes identified\n\nTranscript:\n', triggerBody()?['TranscriptContent'])",
      "runAfter": {
        "Initialize_File_Name_Without_Extension": [
          "Succeeded"
        ]
      },
      "metadata": {
        "operationMetadataId": "action-child2-002"
      }
    },
    "Generate_AI_Summary": {
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "connectionName": "shared_aibuilder_gpt",
          "operationId": "PredictGPT",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_aibuilder_gpt"
        },
        "parameters": {
          "prompt": "@outputs('Create_Summary_Prompt')",
          "temperature": 0.7,
          "max_tokens": 1000,
          "top_p": 0.95
        },
        "authentication": "@parameters('$authentication')"
      },
      "runAfter": {
        "Create_Summary_Prompt": [
          "Succeeded"
        ]
      },
      "metadata": {
        "operationMetadataId": "action-child2-003"
      }
    },
    "Initialize_Summary_Text": {
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "SummaryText",
            "type": "string",
            "value": "@body('Generate_AI_Summary')?['text']"
          }
        ]
      },
      "runAfter": {
        "Generate_AI_Summary": [
          "Succeeded"
        ]
      },
      "metadata": {
        "operationMetadataId": "action-child2-004"
      }
    },
    "Create_Insights_Prompt": {
      "type": "Compose",
      "inputs": "@concat('Based on this summary, identify:\n1. Key patterns in the discussion\n2. Sentiment analysis (positive, neutral, negative)\n3. Main participants (if identifiable)\n4. Important decisions or conclusions\n5. Follow-up questions or areas needing clarification\n\nSummary:\n', variables('SummaryText'))",
      "runAfter": {
        "Initialize_Summary_Text": [
          "Succeeded"
        ]
      },
      "metadata": {
        "operationMetadataId": "action-child2-005"
      }
    },
    "Generate_AI_Insights": {
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "connectionName": "shared_aibuilder_gpt",
          "operationId": "PredictGPT",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_aibuilder_gpt"
        },
        "parameters": {
          "prompt": "@outputs('Create_Insights_Prompt')",
          "temperature": 0.7,
          "max_tokens": 800,
          "top_p": 0.95
        },
        "authentication": "@parameters('$authentication')"
      },
      "runAfter": {
        "Create_Insights_Prompt": [
          "Succeeded"
        ]
      },
      "metadata": {
        "operationMetadataId": "action-child2-006"
      }
    },
    "Initialize_Insights_Text": {
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "InsightsText",
            "type": "string",
            "value": "@body('Generate_AI_Insights')?['text']"
          }
        ]
      },
      "runAfter": {
        "Generate_AI_Insights": [
          "Succeeded"
        ]
      },
      "metadata": {
        "operationMetadataId": "action-child2-007"
      }
    },
    "Compose_Full_Report_HTML": {
      "type": "Compose",
      "inputs": "@concat('<html><head><style>body{font-family:Arial,sans-serif;margin:40px;}h1{color:#0078D4;}h2{color:#106EBE;border-bottom:2px solid #0078D4;padding-bottom:5px;}p{line-height:1.6;}.metadata{background:#f5f5f5;padding:15px;border-radius:5px;margin:20px 0;}.section{margin:30px 0;}</style></head><body><h1>Meeting Analysis Report</h1><div class=\"metadata\"><strong>File:</strong> ', triggerBody()?['FileName'], '<br/><strong>Generated:</strong> ', utcNow(), '</div><div class=\"section\"><h2>Summary</h2><p>', replace(variables('SummaryText'), decodeUriComponent('%0A'), '<br/>'), '</p></div><div class=\"section\"><h2>Insights and Patterns</h2><p>', replace(variables('InsightsText'), decodeUriComponent('%0A'), '<br/>'), '</p></div><div class=\"section\"><h2>Full Transcript</h2><p style=\"font-size:0.9em;color:#666;\">', replace(triggerBody()?['TranscriptContent'], decodeUriComponent('%0A'), '<br/>'), '</p></div></body></html>')",
      "runAfter": {
        "Initialize_Insights_Text": [
          "Succeeded"
        ]
      },
      "metadata": {
        "operationMetadataId": "action-child2-008"
      }
    },
    "Convert_HTML_to_PDF": {
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "connectionName": "shared_conversionservice",
          "operationId": "HtmlToPdf",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_conversionservice"
        },
        "parameters": {
          "html": "@outputs('Compose_Full_Report_HTML')"
        },
        "authentication": "@parameters('$authentication')"
      },
      "runAfter": {
        "Compose_Full_Report_HTML": [
          "Succeeded"
        ]
      },
      "metadata": {
        "operationMetadataId": "action-child2-009"
      }
    },
    "Compose_PDF_File_Name": {
      "type": "Compose",
      "inputs": "@concat(variables('FileNameWithoutExt'), '.pdf')",
      "runAfter": {
        "Convert_HTML_to_PDF": [
          "Succeeded"
        ]
      },
      "metadata": {
        "operationMetadataId": "action-child2-010"
      }
    },
    "Create_PDF_File": {
      "type": "OpenApiConnection",
      "inputs": {
        "host": {
          "connectionName": "shared_onedriveforbusiness",
          "operationId": "CreateFile",
          "apiId": "/providers/Microsoft.PowerApps/apis/shared_onedriveforbusiness"
        },
        "parameters": {
          "dataset": "root",
          "folderPath": "@parameters('hawkeye_SummaryFolderPath (hawkeye_SummaryFolderPath)')",
          "name": "@outputs('Compose_PDF_File_Name')",
          "body": "@body('Convert_HTML_to_PDF')"
        },
        "authentication": "@parameters('$authentication')"
      },
      "runAfter": {
        "Compose_PDF_File_Name": [
          "Succeeded"
        ]
      },
      "metadata": {
        "operationMetadataId": "action-child2-011"
      }
    },
    "Response": {
      "type": "Response",
      "kind": "Http",
      "inputs": {
        "statusCode": 200,
        "body": {
          "Summary": "@variables('SummaryText')",
          "Insights": "@variables('InsightsText')",
          "PDFFileId": "@outputs('Create_PDF_File')?['body/Id']",
          "PDFFileName": "@outputs('Compose_PDF_File_Name')"
        },
        "schema": {
          "type": "object",
          "properties": {
            "Summary": {
              "type": "string"
            },
            "Insights": {
              "type": "string"
            },
            "PDFFileId": {
              "type": "string"
            },
            "PDFFileName": {
              "type": "string"
            }
          }
        }
      },
      "runAfter": {
        "Create_PDF_File": [
          "Succeeded"
        ]
      },
      "metadata": {
        "operationMetadataId": "action-child2-012"
      }
    }
  },
  "outputs": {}
}
